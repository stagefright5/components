// Configuration for IDEs only.
{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "rootDir": "..",
    "baseUrl": ".",
    "paths": {
      "@stagefright5/cdk/*": ["../cdk/*"],
      "@stagefright5/material/*": ["../material/*"],
      "@stagefright5/cdk-experimental/*": ["../cdk-experimental/*"],
      "@stagefright5/material-experimental/*": ["../material-experimental/*"],
      "@material/*": ["../../node_modules/@material/*/index.d.ts"]
    }
  },
  "include": ["./**/*.ts", "../dev-mode-types.d.ts"]
}
